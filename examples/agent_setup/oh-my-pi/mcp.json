{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "gigacode": {
      "type": "stdio",
      "command": "gigacode-mcp",
      "args": [
        "--work-dir",
        "/absolute/path/to/.gigacode-buffers",
        "--tool-profile",
        "agent_core"
      ]
    }
  }
}
